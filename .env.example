# Required: key from https://openrouter.ai/keys (free models need no credit but are capped per day)
OPENROUTER_API_KEY=
# Tried in order: primary model, fallback, then openrouter/free (any free tool-calling model) as a last resort.
# Current free models: https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
# Public URL of the deployment (sent to OpenRouter as HTTP-Referer)
APP_URL=http://localhost:8000

# Optional web search (used only when the data has no answer). Set ONE key.
# Tavily: https://tavily.com (free development keys have limits). Firecrawl: https://firecrawl.dev
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# SEARCH_PROVIDER=tavily        # force a provider, or "off"

# Abuse and cost controls (defaults shown)
# RATE_LIMIT_PER_MIN=8
# RATE_LIMIT_PER_DAY=60
# GLOBAL_LIMIT_PER_DAY=400      # protects the free model quota
# MAX_CONCURRENT_CHATS=4
# TRUSTED_PROXY_HOPS=1          # 1 behind Render's proxy, 0 when nothing sits in front
# MAX_MESSAGE_CHARS=1500
# VERIFY_ANSWERS=1              # rewrite answers whose figures are not in the tool results
# ENABLE_DOCS=0                 # set 1 to expose /docs
